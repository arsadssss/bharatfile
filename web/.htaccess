# DocToolKit - Production Web Configuration (https://doctoolkit.in/)
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Prevent directory listing
Options -Indexes

# UTF-8 Encoding
AddDefaultCharset UTF-8

# Canonical Domain Redirection (www -> non-www) & HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Redirect www to non-www
  RewriteCond %{HTTP_HOST} ^www\.doctoolkit\.in$ [NC]
  RewriteRule ^(.*)$ https://doctoolkit.in/$1 [R=301,L]
  
  # Enforce HTTPS without redirect loops
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://doctoolkit.in/$1 [R=301,L]
</IfModule>

# Proper MIME types
<IfModule mod_mime.c>
  AddType application/manifest+json .json
  AddType text/javascript .js
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType image/png .png
  AddType image/x-icon .ico
  AddType application/xml .xml
</IfModule>

# Gzip / Brotli Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Browser Caching & Controlled Cache Lifetimes
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  
  # HTML, Feeds & Crawl Directives: Always revalidate immediately
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/xml "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType text/plain "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 0 seconds"
  
  # Mutable application code: Cache up to 1 day with validation
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"
  
  # Static Media & Vendor Libraries: Cache up to 30 days
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
</IfModule>

# Caching & Security Headers
<IfModule mod_headers.c>
  # 1. HTML documents must revalidate to serve fresh content and SEO metadata
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # 2. Search engine & discovery directives must always be fresh
  <FilesMatch "^(robots\.txt|sitemap\.xml|manifest\.json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # 3. Service worker must never be cached by browser or proxies
  <Files "sw.js">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </Files>

  # 4. Mutable application CSS & JS (1 day cache with conditional ETag / 304 revalidation)
  <FilesMatch "(style\.css|app\.js)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>

  # 5. Vendor libraries (pdf-lib, pdf.js) - 30 days cache
  <FilesMatch "\.min\.js$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # 6. Static media & brand assets (webp, png, jpg, jpeg, svg, ico) - 30 days cache
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  
  # Security Headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
